{
	"name": "@docucraft/icons",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"types": "index.d.ts",
	"module": "./index.js",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js",
			"require": "./index.js"
		},
		"./svg": {
			"types": "./svg/index.d.ts",
			"import": "./svg/index.js",
			"require": "./svg/index.js"
		},
		"./svg/*": {
			"types": "./svg/*.d.ts",
			"import": "./svg/*.js",
			"require": "./svg/*.js"
		},
		"./styles": {
			"types": "./styles/index.d.ts",
			"import": "./styles/index.js",
			"require": "./styles/index.js"
		}
	},
	"scripts": {
		"dev": "tsc -w",
		"build:svg": "svgr ./node_modules/@material-symbols/svg-400/rounded -d svg",
		"build:logo": "svgr ./assets/logo -d logo",
		"build:custom": "svgr ./assets/custom -d svg",
		"build": "tsc"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@fontsource-variable/material-symbols-rounded": "^5.1.0",
		"@material-design-icons/svg": "^0.14.13",
		"@material-symbols/svg-400": "^0.26.0",
		"@svgr/cli": "^8.1.0",
		"fontkit": "^2.0.4",
		"react": "^18.3.1"
	}
}
