{
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@docucraft/srender",
		"declarationDir": "dist",
		"outDir": "dist",
		"rootDir": "src",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "node",
		"declaration": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"preserveSymlinks": false
	},
	"include": ["./src/**/*"]
}
