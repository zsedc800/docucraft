{
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@docucraft/srender",
		"declarationDir": "dist",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "node",
		"rootDir": ".",
		"declaration": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true
	},
	"include": ["./src/**/*"]
}
