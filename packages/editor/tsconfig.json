	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@docucraft/srender",
		"declarationDir": "dist",
		"target": "ESNext",
		"typeRoots": ["types", "node_modules/@types"],
		"module": "ESNext",
		"moduleResolution": "node",

		"declaration": true,
		// "emitDeclarationOnly": true,
		// "outFile": "dist/index.d.ts",
		"esModuleInterop": true,
		// "strict": true,
		"skipLibCheck": true,
		"baseUrl": "."
		// "paths": {
		// 	"react": ["@docucraft/srender"]
		// }
	},
	"include": ["./src/*", "./src/icon.d.ts"],
	"exclude": ["node_modules"]
}
